<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- Oferece para dispositivos que tem camera -->
    <uses-feature android:name="android.hardware.camera.any"/>

    <!-- Usuário tem que permitir manualmente -->
    <uses-permission android:name="android.permission.CAMERA"/>

    <!-- usa internet para fazer o compartilhamento da foto (se necessário) -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <application

        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.SuperID"
        tools:targetApi="31">
        <!--        <application-->
        <!--        android:label="@string/title_activity_settings"-->
        <!--        android:icon="@mipmap/ic_settings_launcher">  &lt;!&ndash; Corrected line &ndash;&gt;-->
        <!--            &lt;!&ndash; other activity settings like intent filters &ndash;&gt;-->
        <!--            </application>-->

        <provider
            android:authorities="br.com.cameraandroid.fileprovider"
            android:name="androidx.core.content.FileProvider"
            android:grantUriPermissions="true"
            android:exported="false">

        <meta-data
            android:name="android.support.FILE_PROVIDER_PATHS"
            android:resource="@xml/filepaths"/>

        </provider>

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.SuperID">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".CameraActivity"
            android:exported="false"
            android:label="Camera"
            android:screenOrientation="portrait"
            tools:ignore="DiscouragedApi, LockedOrientationActivity" />
    </application>
</manifest>